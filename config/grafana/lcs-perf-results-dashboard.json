    {
      "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 9,
      "options": { "displayMode": "basic", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": true }, "showUnfilled": true },
      "repeat": "targets",
      "repeatDirection": "v",
      "targets": [{
        "alias": "",
        "bucketAggs": [{ "field": "uuid.keyword", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_term", "size": "0" }, "type": "terms" }],
        "metrics": [{ "field": "users", "id": "1", "settings": { "missing": "0" }, "type": "sum" }],
        "query": "uuid.keyword:$uuid AND duration: $duration AND users: $users AND metricName.keyword: $targets",
        "refId": "A",
        "timeField": "timestamp"
