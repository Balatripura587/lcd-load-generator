      "repeat": "targets",
      "repeatDirection": "v",
      "targets": [{
        "alias": "",
        "bucketAggs": [{ "field": "uuid.keyword", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_term", "size": "0" }, "type": "terms" }],
        "metrics": [{ "field": "throughput", "id": "1", "settings": { "missing": "0" }, "type": "sum" }],
        "query": "uuid.keyword:$uuid AND duration: $duration AND users: $users AND metricName.keyword: $targets",
