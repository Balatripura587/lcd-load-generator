{
  "title": "LCS Load Test Results",
  "uid": "lcs-load-test-results",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-2d", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "Datasource",
        "options": [],
        "query": "elasticsearch",
        "refresh": 1,
        "regex": "/(.*LCS.*)/",
        "type": "datasource"
      },
      {
        "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
        "definition": "{\"find\": \"terms\", \"field\": \"duration.keyword\"}",
        "hide": 0,
        "includeAll": true,
        "label": "duration",
        "multi": true,
        "name": "duration",
        "query": "{\"find\": \"terms\", \"field\": \"duration.keyword\"}",
        "refresh": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
        "definition": "{\"find\": \"terms\", \"field\": \"users\"}",
        "hide": 0,
        "includeAll": true,
        "label": "users",
        "multi": true,
        "name": "users",
        "query": "{\"find\": \"terms\", \"field\": \"users\"}",
        "refresh": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
        "definition": "{\"find\": \"terms\", \"field\": \"uuid.keyword\", \"query\":\"duration: $duration AND users: $users\"}",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "uuid",
        "query": "{\"find\": \"terms\", \"field\": \"uuid.keyword\", \"query\":\"duration: $duration AND users: $users\"}",
        "refresh": 2,
        "type": "query"
      },
      {
        "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
        "definition": "{\"find\": \"terms\", \"field\": \"metricName.keyword\", \"query\":\"duration: $duration AND users: $users\"}",
        "hide": 0,
        "includeAll": true,
        "label": "targets",
        "multi": true,
        "name": "targets",
        "query": "{\"find\": \"terms\", \"field\": \"metricName.keyword\", \"query\":\"duration: $duration AND users: $users\"}",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP Benchmarking Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "barWidth": 0.95, "legend": { "displayMode": "list", "placement": "right", "showLegend": false } },
      "targets": [{
        "alias": "",
        "bucketAggs": [{ "field": "metricName.keyword", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_term", "size": "10" }, "type": "terms" }],
        "metrics": [{ "field": "p99Latency", "id": "1", "type": "avg" }],
        "query": "uuid.keyword:$uuid AND duration: $duration AND users: $users",
        "refId": "A",
        "timeField": "timestamp"
      }],
      "title": "P99 Latency: $uuid",
      "type": "barchart"
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "barWidth": 0.97, "legend": { "displayMode": "list", "placement": "right", "showLegend": false } },
      "targets": [{
        "alias": "",
        "bucketAggs": [{ "field": "metricName.keyword", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_term", "size": "10" }, "type": "terms" }],
        "metrics": [{ "field": "throughput", "id": "1", "type": "avg" }],
        "query": "uuid.keyword:$uuid AND duration: $duration AND users: $users",
        "refId": "A",
        "timeField": "timestamp"
      }],
      "title": "Average Throughput: $uuid",
      "type": "barchart"
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "options": { "barWidth": 0.97, "legend": { "displayMode": "list", "placement": "right", "showLegend": false } },
      "targets": [{
        "alias": "",
        "bucketAggs": [{ "field": "metricName.keyword", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_term", "size": "10" }, "type": "terms" }],
        "metrics": [{ "field": "statusCodes.200", "id": "1", "type": "avg" }],
        "query": "uuid.keyword:$uuid AND duration: $duration AND users: $users",
        "refId": "A",
        "timeField": "timestamp"
      }],
      "title": "2XX Responses: $uuid",
      "type": "barchart"
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "options": { "barWidth": 0.97, "legend": { "displayMode": "list", "placement": "right", "showLegend": false } },
      "targets": [{
        "alias": "",
        "bucketAggs": [{ "field": "metricName.keyword", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_term", "size": "10" }, "type": "terms" }],
        "metrics": [{ "field": "statusCodes.error", "id": "1", "settings": { "missing": "0" }, "type": "avg" }],
        "query": "uuid.keyword:$uuid AND duration: $duration AND users: $users",
        "refId": "A",
        "timeField": "timestamp"
      }],
      "title": "Error Responses: $uuid",
      "type": "barchart"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 6,
      "title": "Target Details",
      "type": "row"
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "${Datasource}" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 18 },
      "id": 7,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "targets": [{
        "alias": "",
        "bucketAggs": [],
        "metrics": [{ "id": "1", "settings": { "size": "500" }, "type": "raw_data" }],
        "query": "uuid.keyword:$uuid AND duration: $duration AND users: $users AND metricName.keyword: $targets",
        "refId": "A",
        "timeField": "timestamp"
      }],
      "title": "$targets summary",
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["uuid", "metricName", "requests", "throughput", "elapsedTime", "timestamp", "endTimestamp", "users"] } } }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
