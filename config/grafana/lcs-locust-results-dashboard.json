      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "elasticsearch", "uid": "PA801FE6A79902023" },
      "targets": [
        {
          "alias": "p50",
          "bucketAggs": [{ "field": "timestamp", "id": "2", "type": "date_histogram", "settings": { "interval": "auto" } }],
          "metrics": [{ "field": "p50Latency", "id": "1", "type": "max" }],
          "query": "metricName:post_query",
          "refId": "A",
          "timeField": "timestamp"
        },
        {
          "alias": "p95",
          "bucketAggs": [{ "field": "timestamp", "id": "4", "type": "date_histogram", "settings": { "interval": "auto" } }],
